# Copy to .env and replace every placeholder before starting the backend.
JWT_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://pulseops_app:replace-with-database-password@127.0.0.1:5432/pulseops

# Optional: enable Gemini-backed Copilot chat.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
